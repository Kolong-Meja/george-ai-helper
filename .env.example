# Salin file ini jadi .env (atau ~/.config/george/.env kalau George kamu
# di-install global), lalu isi sesuai identitas kamu sendiri.
#
# .env yang asli TIDAK ikut ke-commit (lihat .gitignore) - jadi orang yang
# clone/fork repo ini nggak bakal ketauan nama & tanggal lahir kamu.

# Nama yang dipanggil George di tiap balasan (sapaan, closing remark, dst).
GEORGE_USER_NAME=Sob

# Tanggal ulang tahun, dipakai buat ucapan spesial sekali setahun.
# Biarin 0 kalau nggak mau fitur ini aktif.
GEORGE_BIRTHDAY_MONTH=0
GEORGE_BIRTHDAY_DAY=0

# Opsional - tahun lahir, biar George bisa nyebut umur kamu pas ultah.
# 0 = nggak ditampilkan.
GEORGE_BIRTH_YEAR=0